# _headers | 보안 헤더 (Cloudflare Pages / Netlify 에서 자동 적용 — 같은 문법입니다)
# 브라우저에게 "이 사이트는 이런 규칙으로만 동작시켜 줘" 라고 알려 주는 설정입니다.
#
# 기본값은 "*.supabase.co" (Supabase 서비스에만 접속 허용) 이라 수정 없이 바로 쓸 수 있습니다.
# (선택) 더 엄격하게: 아래의 *.supabase.co 를 내 프로젝트 주소(예: abcd1234.supabase.co)로 바꾸면
#        "내 Supabase 하나"로만 통신할 수 있습니다. 바꿀 때는 3군데(img-src, connect-src 의 https 와 wss) 모두 바꾸세요. (지도용 tiles.openfreemap.org, photon.komoot.io, nominatim.openstreetmap.org 는 그대로 두세요)

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob: https://*.supabase.co https://*.visitkorea.or.kr; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://tiles.openfreemap.org https://photon.komoot.io https://nominatim.openstreetmap.org; worker-src 'self' blob:; child-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin

/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache

/sw.js
  Cache-Control: no-cache

/index.html
  Cache-Control: no-cache

/js/*
  Cache-Control: no-cache

/css/*
  Cache-Control: no-cache

/icons/*
  Cache-Control: public, max-age=31536000, immutable
